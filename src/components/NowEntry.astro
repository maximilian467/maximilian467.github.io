---
import { ui, type Locale } from '../i18n/ui';
interface Props { title: string; body: string; lang: Locale; }
const { title, body, lang } = Astro.props;
---
<article class="entry" data-reveal>
  <div class="entry-meta mono"><span>{ui[lang].asOf}</span><span class="status running">{ui[lang].running}</span></div>
  <div class="entry-content"><h3>{title}</h3><p>{body}</p></div>
</article>
