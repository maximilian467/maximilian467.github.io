---
import { ui, type Locale } from '../i18n/ui';
interface Props { lang: Locale; caption: string; }
const { lang, caption } = Astro.props;
const t = ui[lang];
---
<figure class="hero-figure" aria-label={t.figure} data-cartpole data-lang={lang} data-play={t.play} data-pause={t.pause} data-error={t.unavailable}>
  <div class="lab">
    <div class="lab-heading mono"><span translate="no">CartPole</span><span translate="no">PPO</span></div>
    <div class="lab-stage">
      <svg class="lab-still" viewBox="0 0 480 360" role="img" aria-label={t.figure}>
        <defs><pattern id="lab-grid" width="24" height="24" patternUnits="userSpaceOnUse"><path d="M24 0H0V24" fill="none" stroke="var(--lab-rule)" stroke-width=".7" /></pattern></defs>
        <rect class="lab-grid" width="480" height="360" fill="url(#lab-grid)" />
        <path d="M20 275H460" stroke="var(--lab-muted)" />
        <g fill="none" stroke="var(--lab-ink)" stroke-width="1.5"><rect x="211" y="249" width="58" height="24" /><circle cx="222" cy="279" r="5" /><circle cx="258" cy="279" r="5" /></g>
        <path d="M240 249L248 101" stroke="var(--lab-accent)" stroke-width="3" />
        <circle cx="240" cy="249" r="4" fill="var(--lab-ink)" />
      </svg>
      <canvas width="960" height="720" aria-hidden="true" hidden></canvas>
      <button class="lab-hit" aria-label={t.nudgeLabel} title={t.nudgeLabel} hidden></button>
    </div>
    <div class="lab-bottom">
      <div class="readouts mono" aria-hidden="true" hidden><span data-theta></span><span data-x></span><span data-step-label={t.step}></span></div>
      <div class="lab-controls" hidden><button data-nudge>{t.nudge}</button><button data-toggle>{t.pause}</button></div>
      <noscript><style>.lab-message { display: none; }</style><p class="mono">{t.staticFigure}</p></noscript>
      <p class="lab-message mono" role="status" data-message>{t.loading}</p>
    </div>
  </div>
  <figcaption class="mono">{caption}</figcaption>
</figure>
<style>
  .lab { background: var(--lab); color: var(--lab-ink); border: 1px solid var(--lab-rule); }
  .lab-heading { display: flex; justify-content: space-between; padding: .85rem 1.1rem; color: var(--lab-muted); }
  .lab-stage { position: relative; aspect-ratio: 4 / 3; margin: 0 1rem; }
  .lab-stage canvas, .lab-still { display: block; width: 100%; height: 100%; }
  .lab-still { position: absolute; inset: 0; }
  .lab-hit { position: absolute; inset: 0; width: 100%; height: 100%; background: transparent; border: 0; }
  .lab-hit:hover { background: rgb(255 255 255 / .015); }
  .lab :focus-visible { outline-color: var(--lab-accent); outline-offset: -4px; }
  .lab-bottom { padding: .8rem 1.1rem; border-top: 1px solid var(--lab-rule); }
  .readouts { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .2rem .75rem; color: var(--lab-muted); font-variant-numeric: tabular-nums; min-height: 22px; }
  .lab-controls { display: flex; gap: 1.5rem; margin-top: .2rem; }
  .lab-controls button { min-height: 44px; border: 0; padding: .25rem 0; background: none; text-decoration: underline; text-underline-offset: .25em; font-size: .8125rem; }
  .lab-controls button:hover { color: var(--lab-accent); }
  .lab-message, noscript .mono { color: var(--lab-muted); }
  figcaption { margin-top: .85rem; }
</style>
<script>
  import { action, step, failed, initialState, type Policy, type State } from '../lib/cartpole';
  const root = document.querySelector<HTMLElement>('[data-cartpole]');
  if (root) init(root);
  async function init(root: HTMLElement) {
    const canvas = root.querySelector('canvas')!;
    const context = canvas.getContext('2d');
    const message = root.querySelector<HTMLElement>('[data-message]')!;
    if (!context) { message.textContent = root.dataset.error!; return; }
    try {
      const response = await fetch('/models/cartpole-policy.json');
      if (!response.ok) throw new Error('Policy unavailable');
      const policy: Policy = await response.json();
      if (!policy.hidden?.length || policy.action?.W.length !== 2 || policy.physics?.tau !== .02) throw new Error('Invalid policy');
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
      const hit = root.querySelector<HTMLButtonElement>('.lab-hit')!;
      const thetaValue = root.querySelector<HTMLElement>('[data-theta]')!;
      const xValue = root.querySelector<HTMLElement>('[data-x]')!;
      const stepValue = root.querySelector<HTMLElement>('[data-step-label]')!;
      const lab = root.querySelector<HTMLElement>('.lab')!;
      const classic = document.body.dataset.design === 'classic';
      let state: State = initialState(), count = 0, paused = reduced.matches;
      let inView = false, frame = 0, last = 0, accumulator = 0, resetAge = -1;
      let width = 480, height = 360, lastReadout = -1;
      let ink = '', muted = '', rule = '', accent = '';
      const number = (digits: number) => new Intl.NumberFormat(root.dataset.lang, { minimumFractionDigits: digits, maximumFractionDigits: digits });
      const angleFormat = number(3), positionFormat = number(2), countFormat = number(0);
      function colors() {
        const css = getComputedStyle(lab);
        // Read resolved colors through the canvas CSS properties, including the classic theme.
        ink = css.getPropertyValue(classic ? '--ink' : '--lab-ink').trim();
        muted = css.getPropertyValue(classic ? '--ink-muted' : '--lab-muted').trim();
        rule = css.getPropertyValue(classic ? '--rule' : '--lab-rule').trim();
        accent = css.getPropertyValue(classic ? '--accent' : '--lab-accent').trim();
      }
      function draw() {
        if (!context) return;
        const ctx = context;
        ctx.clearRect(0, 0, width, height);
        const unit = width / 480;
        if (!classic) {
          ctx.strokeStyle = rule; ctx.lineWidth = .6;
          ctx.beginPath();
          for (let x = 0; x <= width; x += 24 * unit) { ctx.moveTo(x, 0); ctx.lineTo(x, height); }
          for (let y = 0; y <= height; y += 24 * unit) { ctx.moveTo(0, y); ctx.lineTo(width, y); }
          ctx.stroke();
        }
        const rail = height * .77;
        ctx.strokeStyle = muted; ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(8 * unit, rail); ctx.lineTo(width - 8 * unit, rail);
        for (let x = 16 * unit; x < width; x += 24 * unit) { ctx.moveTo(x, rail - 4 * unit); ctx.lineTo(x, rail + 4 * unit); }
        ctx.stroke();
        ctx.save();
        if (resetAge >= 0) ctx.globalAlpha = Math.abs(resetAge - .15) / .15;
        const cx = width / 2 + state[0] * (width - 70 * unit) / 4.8;
        const pivot = rail - 23 * unit, length = height * .43;
        const tipX = cx + Math.sin(state[2]) * length, tipY = pivot - Math.cos(state[2]) * length;
        ctx.strokeStyle = ink; ctx.lineWidth = 1.5;
        ctx.strokeRect(cx - 29 * unit, pivot, 58 * unit, 20 * unit);
        for (const offset of [-19, 19]) { ctx.beginPath(); ctx.arc(cx + offset * unit, rail + 4 * unit, 5 * unit, 0, 2 * Math.PI); ctx.stroke(); }
        ctx.strokeStyle = accent; ctx.lineWidth = 3;
        ctx.beginPath(); ctx.moveTo(cx, pivot); ctx.lineTo(tipX, tipY); ctx.stroke();
        ctx.fillStyle = ink; ctx.beginPath(); ctx.arc(cx, pivot, 3.5 * unit, 0, 2 * Math.PI); ctx.fill();
        ctx.restore();
        if (count !== lastReadout && (count % 5 === 0 || paused)) {
          thetaValue.textContent = `θ = ${angleFormat.format(state[2])} rad`;
          xValue.textContent = `x = ${positionFormat.format(state[0])} m`;
          stepValue.textContent = `${stepValue.dataset.stepLabel} ${countFormat.format(count)}`;
          lastReadout = count;
        }
      }
      function tick(time: number) {
        frame = 0;
        if (paused || !inView || document.hidden) return;
        const elapsed = last ? Math.min((time - last) / 1000, .1) : 0;
        last = time;
        if (resetAge >= 0) {
          const previousAge = resetAge;
          resetAge += elapsed;
          if (previousAge < .15 && resetAge >= .15) { state = initialState(); count = 0; }
          if (resetAge >= .3) { resetAge = -1; accumulator = 0; }
        } else {
          accumulator += elapsed;
          while (accumulator >= policy.physics.tau) {
            state = step(state, action(policy, state), policy.physics);
            count++; accumulator -= policy.physics.tau;
            if (failed(state, policy.physics)) { resetAge = 0; accumulator = 0; break; }
          }
        }
        draw(); frame = requestAnimationFrame(tick);
      }
      function sync() {
        cancelAnimationFrame(frame); frame = 0; last = 0; accumulator = 0;
        toggle.textContent = paused ? root.dataset.play! : root.dataset.pause!;
        root.dataset.state = paused ? 'paused' : 'running';
        if (!paused && inView && !document.hidden) frame = requestAnimationFrame(tick);
        draw();
      }
      function nudge() {
        if (resetAge >= 0) return;
        state[3] += Math.random() < .5 ? -.6 : .6;
        // A nudge never silently overrides an explicit pause or reduced-motion preference.
        draw();
      }
      function resize() {
        const rect = canvas.getBoundingClientRect();
        width = rect.width; height = rect.height;
        const dpr = window.devicePixelRatio || 1;
        canvas.width = Math.round(width * dpr); canvas.height = Math.round(height * dpr);
        context!.setTransform(dpr, 0, 0, dpr, 0, 0); colors(); draw();
      }
      canvas.hidden = false;
      root.querySelector<SVGElement>('.lab-still')!.style.display = 'none';
      hit.hidden = false;
      root.querySelector<HTMLElement>('.readouts')!.hidden = false;
      root.querySelector<HTMLElement>('.lab-controls')!.hidden = false;
      message.hidden = true;
      root.querySelector<HTMLButtonElement>('[data-nudge]')!.addEventListener('click', nudge);
      hit.addEventListener('click', nudge);
      toggle.addEventListener('click', () => { paused = !paused; sync(); });
      document.addEventListener('visibilitychange', sync);
      reduced.addEventListener('change', () => { if (reduced.matches) paused = true; sync(); });
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => { colors(); draw(); });
      new ResizeObserver(resize).observe(canvas);
      new IntersectionObserver(entries => { inView = entries[0]!.isIntersecting; sync(); }).observe(root);
      window.addEventListener('resize', resize);
      resize(); sync();
    } catch { message.textContent = root.dataset.error!; }
  }
</script>
