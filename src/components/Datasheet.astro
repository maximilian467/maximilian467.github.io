---
// Measurement table. One metric may carry a short `highlight` value, shown large beside the table.
interface Props { metrics: { label: string; value: string; highlight?: string }[]; title: string; }
const { metrics, title } = Astro.props;
const featured = metrics.find(metric => metric.highlight);
---
<div class:list={['datasheet', { plain: !featured }]}>
  {featured && <div class="measurement" aria-hidden="true"><strong>{featured.highlight}</strong><span class="mono">{featured.label}</span></div>}
  <table class="mono">
    <caption class="sr-only">{title}</caption>
    <tbody>{metrics.map(({ label, value }) => <tr><th scope="row">{label}</th><td>{value}</td></tr>)}</tbody>
  </table>
</div>
