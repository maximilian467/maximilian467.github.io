---
import { routes, type PageKey } from '../i18n/utils';
import { ui, type Locale } from '../i18n/ui';
interface Props { lang: Locale; page?: PageKey; links?: Partial<Record<Locale, string>>; }
const { lang, page = 'home', links } = Astro.props;
// Plain links, no automatic redirect: the URL itself keeps the language a visitor picked.
const href = (target: Locale) => links?.[target] ?? routes[target][page];
---
<nav class="language" aria-label={ui[lang].language}>
  <a href={href('en')} lang="en" hreflang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
  <span aria-hidden="true">/</span>
  <a href={href('de')} lang="de" hreflang="de" aria-current={lang === 'de' ? 'page' : undefined}>DE</a>
</nav>
