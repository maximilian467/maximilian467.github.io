---
import { routes, type PageKey } from '../i18n/utils';
import type { Locale } from '../i18n/ui';
interface Props { lang: Locale; page?: PageKey; }
const { lang, page = 'home' } = Astro.props;
---
<nav class="language" aria-label={lang === 'de' ? 'Sprache' : 'Language'}>
  <a href={routes.de[page]} lang="de" hreflang="de" aria-current={lang === 'de' ? 'page' : undefined}>DE</a>
  <span aria-hidden="true">/</span>
  <a href={routes.en[page]} lang="en" hreflang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
</nav>
