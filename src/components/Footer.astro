---
import { ui, type Locale } from '../i18n/ui';
import { routes } from '../i18n/utils';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = ui[lang];
---
<footer class="site-footer wrap mono">
  <span>© 2026 Maximilian Köhlenbeck</span>
  <nav class="footer-links" aria-label={lang === 'de' ? 'Rechtliches' : 'Legal'}>
    <a href={routes[lang].legal}>{t.legal}</a>
    <a href={routes[lang].privacy}>{t.privacy}</a>
  </nav>
  <span>{t.built}</span>
</footer>
